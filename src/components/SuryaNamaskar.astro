<div class="sun-salutation" role="img" aria-label="Surya Namaskara: a yoga figure follows your scroll through a sun salutation.">
  <svg viewBox="0 0 120 120" fill="none" aria-hidden="true">
    <circle cx="60" cy="60" r="54" class="orbit" />
    <circle cx="60" cy="60" r="54" class="progress" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" transform="rotate(-90 60 60)" />
    <circle cx="87" cy="31" r="7" class="sun" />
    <path d="M87 20v-2m0 26v-2m11-11h2m-26 0h2m19-8 2-2m-20 20 2-2m16 0 2 2m-20-20 2 2" class="sun-rays" />
    <path d="M26 100h68" class="mat" />
    <g stroke-linecap="round" stroke-linejoin="round">
      <path data-limb="far-arm" class="far-limb" d="M60 43 70 57 62 53" />
      <path data-limb="far-leg" class="far-limb" d="M60 70 65 84 66 98" />
      <path data-limb="body" d="M60 43 60 70" />
      <path data-limb="near-leg" d="M60 70 56 84 54 98" />
      <path data-limb="near-arm" d="M60 43 49 57 60 53" />
      <circle data-head cx="60" cy="32" r="6" class="head" />
    </g>
  </svg>
</div>

<style>
  .sun-salutation {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 30;
    width: 112px;
    padding: 5px;
    border: 1px solid var(--color-gold-300);
    border-radius: 50%;
    background: rgb(251 250 246 / .96);
    box-shadow: 0 5px 24px rgb(7 40 38 / .1);
    color: var(--color-peacock-700);
    pointer-events: none;
    user-select: none;
  }
  svg { display: block; width: 100%; }
  .orbit { stroke: var(--color-sand-200); stroke-width: 1; }
  .progress { stroke: var(--color-gold-500); stroke-width: 2; stroke-linecap: round; }
  .sun { fill: var(--color-gold-300); }
  .sun-rays { stroke: var(--color-gold-500); stroke-width: 1.4; stroke-linecap: round; }
  .mat { stroke: var(--color-gold-500); stroke-width: 2; stroke-linecap: round; }
  g { stroke: var(--color-peacock-700); stroke-width: 3.6; }
  .far-limb { stroke: var(--color-peacock-300); stroke-width: 3; }
  .head { fill: var(--color-peacock-700); stroke: none; }
  @media (max-width: 639px) {
    .sun-salutation { width: 88px; right: .75rem; }
  }
</style>

<script>
  const icon = document.querySelector<HTMLElement>('.sun-salutation');
  if (icon) {
    // Head, shoulders, hips, near elbow/hand, far elbow/hand,
    // near knee/foot, far knee/foot. Matching joints morph between poses.
    const poses = [
      // Prayer, raised arms, forward fold, equestrian lunge.
      [[60,32],[60,43],[60,70],[49,57],[60,53],[70,57],[62,53],[56,84],[54,98],[65,84],[66,98]],
      [[55,30],[55,41],[63,69],[43,28],[49,16],[61,27],[53,16],[59,84],[57,98],[67,84],[68,98]],
      [[68,82],[69,71],[52,49],[77,84],[74,98],[72,84],[70,98],[49,74],[47,98],[57,74],[57,98]],
      [[78,52],[70,61],[46,77],[77,80],[79,98],[68,80],[72,98],[64,77],[69,98],[29,89],[19,98]],
      // Plank, eight-point salute, cobra, downward-facing mountain.
      [[85,65],[76,71],[49,79],[77,85],[79,98],[70,85],[72,98],[33,87],[19,98],[36,86],[23,98]],
      [[83,85],[73,90],[49,80],[62,95],[79,98],[60,91],[73,98],[34,97],[19,98],[38,95],[23,98]],
      [[79,61],[71,70],[51,94],[72,84],[77,98],[66,84],[69,98],[34,97],[19,98],[39,94],[23,98]],
      [[76,80],[66,71],[49,44],[80,85],[91,98],[74,84],[85,98],[35,71],[23,98],[40,73],[29,98]],
      // Opposite lunge, fold, raised arms, return to prayer.
      [[78,52],[70,61],[46,77],[77,80],[79,98],[68,80],[72,98],[29,89],[19,98],[64,77],[69,98]],
      [[68,82],[69,71],[52,49],[77,84],[74,98],[72,84],[70,98],[49,74],[47,98],[57,74],[57,98]],
      [[55,30],[55,41],[63,69],[43,28],[49,16],[61,27],[53,16],[59,84],[57,98],[67,84],[68,98]],
      [[60,32],[60,43],[60,70],[49,57],[60,53],[70,57],[62,53],[56,84],[54,98],[65,84],[66,98]],
    ];
    const limbs = [
      ['body', [1, 2]], ['near-arm', [1, 3, 4]],
      ['far-arm', [1, 5, 6]], ['near-leg', [2, 7, 8]], ['far-leg', [2, 9, 10]],
    ] as const;
    const paths = limbs.map(([name, joints]) => ({
      element: icon.querySelector<SVGPathElement>(`[data-limb="${name}"]`)!, joints,
    }));
    const head = icon.querySelector('[data-head]')!;
    const ring = icon.querySelector<SVGCircleElement>('.progress')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    let scrollRange = 0;

    const draw = () => {
      frame = 0;
      const progress = Math.min(1, Math.max(0, window.scrollY / (scrollRange || 1)));
      const position = reducedMotion.matches ? 0 : progress * (poses.length - 1);
      const index = Math.floor(position);
      const next = Math.min(index + 1, poses.length - 1);
      // A short pause at each pose keeps the small figure easy to read.
      const fraction = Math.min(1, Math.max(0, (position - index - .15) / .7));
      const blend = fraction * fraction * (3 - 2 * fraction);
      const joints = poses[index].map((point, joint) => point.map(
        (value, axis) => value + (poses[next][joint][axis] - value) * blend,
      ));
      paths.forEach(({ element, joints: indices }) => {
        element.setAttribute('d', indices.map((joint, i) => `${i ? 'L' : 'M'}${joints[joint].join(' ')}`).join(' '));
      });
      head.setAttribute('cx', String(joints[0][0]));
      head.setAttribute('cy', String(joints[0][1]));
      ring.style.strokeDashoffset = String(1 - progress);
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(draw); };
    const measure = () => {
      scrollRange = document.documentElement.scrollHeight - window.innerHeight;
      schedule();
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure);
    reducedMotion.addEventListener('change', schedule);
    // Images, fonts and the lazy blog list can change the page height.
    const observer = new ResizeObserver(measure);
    observer.observe(document.body);
    measure();
  }
</script>
